---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const studio = (await getCollection('studio')).sort((a,b)=>a.data.order-b.data.order);
const tlist = await getCollection('testimonials');
const t = tlist.find(x=>x.data.show_on==='home') || tlist[0];
const quote = t ? t.body.trim() : '';
---
<BaseLayout home={true} fontItalic={true}>
  <section class="hero">
    <h1 class="hero-mark"><span class="lspc lspc-20">JAPONICA</span></h1>
    <div class="hero-emblem-line"></div>
    <p class="hero-subline"><span class="lspc lspc-36">Sydney wedding floral studio</span></p>
  </section>

  <section class="first-photo">
    <div class="first-photo-frame reveal"><img src="/img/hero-roses.jpg" alt="Japonica white garden roses" /></div>
  </section>

  <section id="about" class="about">
    <div class="philo">
      <h2 class="philo-display reveal">Textural, botanical, organic and a little wild</h2>
      <p class="philo-body reveal">We are Japonica, a small Sydney wedding florist working from a studio in Ryde. For over 10 years we have been designing flowers for couples on their wedding day, alongside private events and celebrations we love just as much.</p>
      <p class="philo-body reveal" style="margin-top:28px;">Our work is garden-style and seasonal, planned around the freshest blooms available the week of your wedding. You bring us the venue and the date. We listen, we ask and we build the florals around the day you have been imagining.</p>
    </div>
  </section>

  <section class="latest-section">
    <div class="latest-header">
      <div class="latest-label reveal"><span class="lspc lspc-36">Latest</span></div>
      <h2 class="reveal">From the studio</h2>
    </div>
    <div class="ig-grid">
      {studio.map(s => (
        <a href={s.data.link} target="_blank" rel="noopener" class="ig-tile reveal"><img src={`/${s.data.image}`} alt={s.data.alt} loading="lazy" /></a>
      ))}
    </div>
    <div class="latest-footer reveal">
      <a href="https://www.instagram.com/__japonica__" target="_blank" rel="noopener" class="ig-link"><span class="lspc lspc-32">Follow on Instagram</span></a>
    </div>
  </section>

  <section class="testimonial-section" aria-labelledby="kind-words">
    <h2 id="kind-words" class="vh">Kind words</h2>
    <div class="testimonial">
      <div class="quote-glyph reveal">&ldquo;</div>
      <div class="quote-body reveal">{quote}</div>
      <div class="quote-attr reveal"><span class="lspc lspc-34">{t?.data.author}</span></div>
    </div>
  </section>

  <section class="closer-section">
    <div class="closer-wrap">
      <figure class="home-reel reveal" data-sound-wrap>
        <video src="/media/japonica-install-music.mp4?v=2" poster="/media/japonica-install-poster.jpg" autoplay muted loop playsinline aria-label="A Japonica installation coming together at Athol Hall"></video>
        <button type="button" class="sound" data-sound aria-pressed="false"><span class="lspc lspc-28">Sound on</span></button>
      </figure>
    <div class="closer">
      <h2 class="closer-line reveal">Preferred at Athol Hall</h2>
      <div class="closer-venues reveal">Japonica is a Ryde based floral studio servicing the Sydney region and surrounds. A regular at Zest The Spit, Orso Bayside, Gunners Barracks, Pasadena Sydney, Manly Pavilion, Q Station and Botanic House.</div>
      <div class="closer-geo reveal"><span class="lspc lspc-32">Northern Beaches &middot; North Shore &middot; Sydney wedding and event florist</span></div>
      <a href="/enquire/" class="cta reveal"><span class="lspc lspc-36">Begin a conversation</span></a>
      <div class="closer-byline reveal"><span class="lspc lspc-32">By appointment, from Ryde</span></div>
    </div>
    </div>
  </section>
  <script>
    document.querySelectorAll('[data-sound-wrap]').forEach(w => {
      const v = w.querySelector('video'), b = w.querySelector('[data-sound]');
      b.addEventListener('click', () => { v.muted = !v.muted; if (!v.muted) v.play(); b.setAttribute('aria-pressed', String(!v.muted)); b.firstElementChild.textContent = v.muted ? 'Sound on' : 'Sound off'; });
    });
  </script>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 24px;
    background: linear-gradient(180deg, #E5DDCC 0%, #E1D8C6 100%); overflow: hidden; isolation: isolate; }
  /* studio light: a soft key light pooled behind the wordmark, edges falling off */
  .hero::before { content: ""; position: absolute; inset: -10%; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 52% 46% at 50% 44%, rgba(255,254,250,1) 0%, rgba(255,251,242,.95) 26%, rgba(249,243,231,.6) 50%, rgba(236,228,213,.15) 72%, rgba(230,222,206,0) 86%);
    opacity: 0; animation: keylight 2.2s .1s ease-out forwards; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 85% 80% at 50% 45%, rgba(0,0,0,0) 55%, rgba(90,70,55,.16) 100%); }
  @keyframes keylight { to { opacity: 1; } }
  .hero-mark { text-shadow: 0 22px 36px rgba(53,42,53,.10), 0 2px 4px rgba(53,42,53,.06); }
  

  .hero-emblem-line { width: 64px; height: 1px; background: var(--ink); margin: 44px 0 0; opacity: 0; transform: scaleX(0); animation: emblem 1.2s 1.2s ease-out forwards; }
  @keyframes emblem { to { opacity: 0.4; transform: scaleX(1); } }
  .hero-mark { margin: 0; font-family: var(--display); font-size: clamp(60px,11vw,164px); font-weight: 400; -webkit-text-stroke: 0.02em var(--ink); line-height: 1; color: var(--ink); opacity: 0; transform: translateY(20px); animation: heroIn 1.4s 0.5s ease-out forwards; }
  .hero-subline { margin-top: 36px; font-size: 17px; font-weight: 500; text-transform: uppercase; color: var(--ink); opacity: 0; animation: heroIn 1.4s 1.5s ease-out forwards; }
  @keyframes heroIn { to { opacity: 1; transform: translateY(0); } }
  @keyframes bob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(4px); } }
  .first-photo { padding: 0; }
  .first-photo-frame { width: 100%; aspect-ratio: 21/9; overflow: hidden; background: #2a201d; }
  .first-photo-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 6s ease; }
  .first-photo-frame:hover img { transform: scale(1.03); }
  .about { padding: 96px 56px 40px; }
  @media (max-width: 880px) { .hero-subline { font-size: 13px; margin-top: 26px; } .hero-emblem-line { margin-top: 30px; } .hero-subline .lspc-36 { letter-spacing: 0.26em; margin-right: -0.26em; } .about { padding: 64px 24px 40px; } }
  .philo { max-width: 760px; margin: 0 auto; text-align: center; }
  .philo-display { font-weight: 400; font-family: var(--display); font-size: clamp(34px,5.4vw,64px); line-height: 1.15; color: var(--ink); margin-bottom: 56px; }
  .philo-body { font-size: 18px; line-height: 1.85; color: var(--ink); max-width: 580px; margin: 0 auto; }
  .testimonial-section { padding: 104px 56px; background: var(--bg-soft); }
  .latest-section { padding: 96px 56px 112px; }
  .latest-header { text-align: center; margin-bottom: 64px; }
  .latest-label { font-size: 11px; text-transform: uppercase; color: var(--stone); margin-bottom: 18px; }
  .latest-header h2 { font-family: var(--display); font-size: clamp(34px,5vw,56px); font-weight: 400; line-height: 1.2; color: var(--ink); }
  .ig-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; max-width: 1100px; margin: 0 auto; }
  .ig-tile { display: block; aspect-ratio: 1; overflow: hidden; background: #b8a98c; border-radius: var(--radius); }
  .ig-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.6s ease; }
  .ig-tile:hover img { transform: scale(1.05); }
  .latest-footer { text-align: center; margin-top: 56px; }
  .ig-link { display: inline-block; font-size: 12px; text-transform: uppercase; color: var(--ink); border-bottom: 0.5px solid rgba(53,42,53,0.35); padding-bottom: 4px; transition: opacity 0.3s; }
  .ig-link:hover { opacity: 0.6; }
  .closer-section { padding: 112px 56px 144px; }
  .closer-wrap { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 5fr 6fr; gap: 80px; align-items: center; }
  .closer { max-width: 820px; margin: 0 auto; text-align: center; }
  .home-reel { position: relative; margin: 0; }
  .home-reel video { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; border-radius: var(--radius); background: #b8a98c; }
  .home-reel .sound { position: absolute; right: 14px; bottom: 14px; appearance: none; border: 0; background: rgba(239,233,220,.9); color: var(--ink); font-family: var(--serif); font-size: 11px; text-transform: uppercase; padding: 10px 16px; border-radius: var(--radius); cursor: pointer; }
  @media (max-width: 880px) { .closer-wrap { grid-template-columns: 1fr; gap: 48px; } }
  .closer-line { font-weight: 400; font-family: var(--display); font-size: clamp(30px,4.4vw,52px); line-height: 1.25; color: var(--ink); margin-bottom: 28px; }
  .closer-venues { font-size: 17px; line-height: 1.9; color: var(--ink-soft); max-width: 640px; margin: 0 auto 32px; }
  .closer-geo { font-size: 11px; text-transform: uppercase; color: var(--stone); margin: 0 auto 56px; }
  .closer-byline { margin-top: 44px; font-size: 11px; text-transform: uppercase; color: var(--stone); }
  @media (max-width: 880px) {
    .about, .testimonial-section, .latest-section, .closer-section { padding: 80px 24px; }
    .about { padding-bottom: 24px; }
    .latest-section { padding-top: 64px; }
    .latest-header { margin-bottom: 40px; }
    .first-photo-frame { aspect-ratio: 4/3; }
    .ig-grid { grid-template-columns: repeat(2,1fr); }
    .closer-section { padding-bottom: 120px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero::before { animation: none; opacity: 1; } .hero-mark, .hero-subline { animation: none; opacity: 1; transform: none; } .hero-emblem-line { animation: none; opacity: .4; transform: none; } }
</style>
